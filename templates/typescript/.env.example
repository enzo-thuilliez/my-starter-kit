# Copy to .env.local and fill in. Never commit it.
DEFAULT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Langfuse tracing (cloud or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Local-first (no paid API): DEFAULT_MODEL=ollama:qwen3:8b, then `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434/v1
